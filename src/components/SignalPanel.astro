---
/**
 * 매수·매도 판단 도우미.
 *
 * 화면 구성은 인베스팅닷컴·트레이딩뷰의 '기술적 요약'을 따랐다. 종합 판정을 눈금 하나로
 * 먼저 보여주고, 그 아래에 그렇게 나온 근거를 지표별로 펼친다. 다만 그쪽은 지표 이름만
 * 늘어놓는 데 반해 여기서는 지표마다 "이게 무엇을 보는 것인지"를 문장으로 붙였다.
 * 초보자에게는 결론보다 그쪽이 오래 남기 때문이다.
 *
 * 결론을 "사세요 / 파세요"로 적지 않는 것은 중요한 원칙이다. 이 계산에는 회사의 실적도
 * 뉴스도 들어 있지 않아서 그렇게 말할 근거가 없고, 그런 표현은 투자 권유가 된다.
 * 그래서 모든 문구를 "신호가 어느 쪽으로 기울어 있다"까지만 말하도록 맞췄다.
 */
import { analyze, type Analysis, type Stance } from "../data/domestic/signals";
import { formatDate, type StockSeries } from "../data/domestic";

interface Props {
  series: StockSeries;
}

const { series } = Astro.props;
const analysis: Analysis = analyze(series);
const { verdict, signals, facts } = analysis;

// 기간은 daily.history가 아니라 이 종목이 실제로 가진 시세로 적는다. 상장한 지
// 얼마 안 된 종목은 6개월치가 없는데 "121영업일"이라고 적으면 거짓말이 된다.
const days = series.days;
const range = { from: days[0].date, to: days[days.length - 1].date, tradingDays: days.length };

const STANCE_LABEL: Record<Stance, string> = {
  buy: "매수 쪽",
  sell: "매도 쪽",
  neutral: "중립",
  unknown: "계산 불가",
};

/** 게이지 눈금 5칸 — 왼쪽이 매도, 오른쪽이 매수다. */
const SEGMENTS = ["strong-sell", "sell", "neutral", "buy", "strong-buy"];

const scoreText = analysis.counted === 0 ? "—" : `${analysis.score > 0 ? "+" : ""}${analysis.score} / ${analysis.counted}`;
---

<section class="detail-section">
  <h2>지금 분위기는 어느 쪽일까</h2>
  <p class="table-caption">
    최근 <strong>{range.tradingDays}영업일</strong>({formatDate(range.from)} ~ {formatDate(range.to)})의
    주가 움직임만으로 계산한 <strong>기술적 신호</strong>입니다. 증권사 앱에서 흔히 보는 지표 다섯 개를
    같은 기준으로 세어 한쪽으로 얼마나 기울었는지 보여줍니다.
  </p>

  <div class={`verdict-card ${verdict.key}`}>
    <div class="verdict-head">
      <div>
        <span class="verdict-eyebrow">기술적 신호 종합</span>
        <p class="verdict-label">{verdict.label}</p>
      </div>
      <span class="verdict-score">
        <span class="mono">{scoreText}</span>
        <span class="score-note">매수 − 매도</span>
      </span>
    </div>

    <div class="gauge" role="img" aria-label={`${verdict.label}. ${verdict.summary}`}>
      <div class="gauge-track">
        {SEGMENTS.map((seg) => <span class={`gauge-seg ${seg}`}></span>)}
        <span class="gauge-marker" style={`left:${verdict.position}%`}></span>
      </div>
      <div class="gauge-scale">
        <span>매도 신호 우세</span>
        <span>중립</span>
        <span>매수 신호 우세</span>
      </div>
    </div>

    <p class="verdict-summary">{verdict.summary}</p>
  </div>

  <p class="verdict-warning">
    <strong>이건 예측이 아닙니다.</strong> 과거 주가의 모양을 정해진 규칙으로 읽은 것일 뿐,
    회사가 돈을 얼마나 버는지도 오늘 무슨 뉴스가 있었는지도 하나도 들어 있지 않습니다.
    같은 신호에서 오르기도 하고 내리기도 합니다.
  </p>

  <h3 class="sub-head">신호 다섯 개를 하나씩</h3>
  <ol class="signal-list">
    {signals.map((signal) => (
      <li class={`signal-row ${signal.stance}`}>
        <div class="signal-mark">
          <span class="signal-stance">{STANCE_LABEL[signal.stance]}</span>
        </div>
        <div class="signal-body">
          <p class="signal-name">{signal.name}</p>
          <p class="signal-headline">{signal.headline}</p>
          <p class="signal-detail mono">{signal.detail}</p>
          <p class="signal-meaning">{signal.meaning}</p>
        </div>
      </li>
    ))}
  </ol>

  {analysis.counted < signals.length && (
    <p class="chart-note">
      계산할 수 없는 지표는 종합 점수에서 빼고 세었습니다. 60일 평균선은 60영업일,
      MACD는 35영업일 넘는 과거 시세가 있어야 나오는데 이 종목은 자료가
      {" "}{analysis.bars}영업일뿐입니다.
    </p>
  )}

  <h3 class="sub-head">함께 봐야 하는 숫자</h3>
  <div class="fact-grid">
    {facts.map((fact) => (
      <div class="fact-card">
        <span class="label">{fact.label}</span>
        <span class="value mono">{fact.value}</span>
        <span class="sub">{fact.note}</span>
      </div>
    ))}
  </div>

  <p class="chart-note">
    이 신호들이 보지 못하는 것 — 회사가 얼마를 버는지, 지금 값이 그 실력에 비해 비싼지,
    무슨 일이 벌어지고 있는지 — 은 아래 두 섹션에서 이어서 봅니다.
  </p>
</section>
