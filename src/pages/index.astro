---
import Layout from "../layouts/Layout.astro";

const sections = [
  {
    href: "/concepts",
    title: "기본 개념",
    desc: "주식이 무엇인지부터 매수·매도, 시가총액, 배당 같은 필수 용어까지 차근차근 정리합니다.",
    badge: "준비 중",
    ready: false,
  },
  {
    href: "/domestic",
    title: "국내 주식",
    desc: "코스피·코스닥 현황과 국내 주요 지표를 쉽게 풀어서 설명합니다.",
    badge: "준비 중",
    ready: false,
  },
  {
    href: "/us",
    title: "미국 주식",
    desc: "S&P 500, 나스닥 등 미국 시장 현황과 대표 지수를 소개합니다.",
    badge: "준비 중",
    ready: false,
  },
];
---

<Layout title="홈">
  <section class="hero">
    <h1>주식, 아무것도 몰라도 여기서부터 시작하세요</h1>
    <p>
      복잡한 용어와 숫자에 겁먹지 않도록, 주식의 기본 개념부터 국내·미국 시장까지
      하나씩 천천히 다룰 예정입니다.
    </p>
  </section>

  <div class="card-grid">
    {sections.map((s) => (
      <a class="card" href={s.href}>
        <span class={`badge ${s.ready ? "" : "soon"}`}>{s.badge}</span>
        <h2>{s.title}</h2>
        <p>{s.desc}</p>
      </a>
    ))}
  </div>

  <p class="notice">
    이 사이트는 한 번에 모든 기능을 만들지 않고, 개념 → 국내 주식 → 미국 주식 순서로
    콘텐츠를 하나씩 추가해 나갈 예정입니다.
  </p>
</Layout>
