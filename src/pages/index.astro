---
import Layout from "../layouts/Layout.astro";
import { glossaryCategories } from "../data/glossary";

// 용어를 더 넣거나 빼도 배지 숫자가 저절로 따라오게 여기서 센다. 손으로 적어두면
// 어느 날 조용히 틀린 숫자가 된다.
const termCount = glossaryCategories.reduce((sum, cat) => sum + cat.terms.length, 0);

const sections = [
  {
    href: "/concepts",
    title: "기본 개념",
    desc: "주식이 무엇인지부터 매수·매도, 시가총액, 배당 같은 필수 용어까지 차근차근 정리합니다.",
    badge: `기초 용어 ${termCount}개`,
    ready: true,
    icon: `<path d="M4 5.5C4 4.67 4.67 4 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z"/><path d="M20 5.5c0-.83-.67-1.5-1.5-1.5H13v16h5.5c.83 0 1.5-.67 1.5-1.5v-13Z"/>`,
  },
  {
    href: "/domestic",
    title: "국내 주식",
    desc: "최근 1개월 동안 코스피·코스닥에서 가장 많이 거래된 종목 TOP100을 정리했습니다.",
    badge: "거래량 TOP100",
    ready: true,
    icon: `<rect x="4" y="12" width="3.2" height="8"/><rect x="10.4" y="6" width="3.2" height="14"/><rect x="16.8" y="9" width="3.2" height="11"/>`,
  },
  {
    href: "/us",
    title: "미국 주식",
    desc: "색깔부터 세금까지, 국내에서 하던 대로 보면 틀리는 것들과 대표 지수 세 가지를 정리했습니다.",
    badge: "국내와 다른 점",
    ready: true,
    icon: `<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 3.5c2.2 2.3 3.4 5.3 3.4 8.5s-1.2 6.2-3.4 8.5M12 3.5c-2.2 2.3-3.4 5.3-3.4 8.5s1.2 6.2 3.4 8.5M4 12h16" stroke="currentColor" stroke-width="1.4" fill="none"/>`,
  },
];
---

<Layout title="홈">
  <section class="hero">
    <span class="eyebrow">초보자를 위한 사이트</span>
    <h1>처음 시작하는 주린이를 위한 가이드</h1>
    <p>
      주식에 필요한 필수 용어를 배울 수 있고, 국내와 미국의 시장을 알아볼 수 있습니다!
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/concepts">기초 용어 보러가기 →</a>
    </div>
  </section>

  <div class="card-grid">
    {sections.map((s) => (
      <a class="card" href={s.href}>
        <span class="card-icon" set:html={`<svg viewBox="0 0 24 24" fill="currentColor">${s.icon}</svg>`} />
        <span class={`badge ${s.ready ? "" : "soon"}`}>{s.badge}</span>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </a>
    ))}
  </div>
</Layout>
