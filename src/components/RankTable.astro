---
import {
  formatVolume,
  formatValue,
  formatPrice,
  exact,
  hasDetailPage,
  noDetailReason,
  getSeries,
  type VolumeRow,
} from "../data/domestic";
import { analyze, type Verdict } from "../data/domestic/signals";

interface Props {
  rows: VolumeRow[];
  /** ETF·ETN이 섞인 목록에서만 구분 열을 보여준다. */
  showKind?: boolean;
}

const { rows, showKind = false } = Astro.props;

/**
 * 종목마다 기술적 신호 한 줄 요약을 붙인다. 순위표에서 바로 방향이 보이면
 * 어떤 종목을 열어볼지 고르기 쉽다. 자세한 근거는 상세 페이지에 있다.
 */
const verdicts = new Map<string, Verdict>(
  rows.flatMap((row) => {
    const series = getSeries(row.code);
    return series ? [[row.code, analyze(series).verdict] as [string, Verdict]] : [];
  }),
);
---

<div class="table-wrap">
  <table class="rank-table">
    <thead>
      <tr>
        <th scope="col" class="col-rank">순위</th>
        <th scope="col">종목명</th>
        <th scope="col">시장</th>
        {showKind && <th scope="col">구분</th>}
        <th scope="col" class="col-num">누적 거래량 (주)</th>
        <th scope="col" class="col-num">누적 거래대금 (원)</th>
        <th scope="col" class="col-num">기준일 종가 (원)</th>
        <th scope="col">기술적 신호</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td class={`rank-num${row.rank <= 3 ? " top" : ""}`}>{row.rank}</td>
          <th scope="row" class="col-name">
            {hasDetailPage(row.code) ? (
              <a class="row-link" href={`/domestic/${row.code}`}>{row.name}<span class="chev" aria-hidden="true">›</span></a>
            ) : (
              <>
                {row.name}
                {noDetailReason(row.code) && (
                  <span class="no-detail">{noDetailReason(row.code)}</span>
                )}
              </>
            )}
          </th>
          <td>
            <span class={`mkt-badge ${row.market === "KOSPI" ? "kospi" : "kosdaq"}`}>
              {row.market === "KOSPI" ? "코스피" : "코스닥"}
            </span>
          </td>
          {showKind && (
            <td><span class="kind-badge">{row.kind}</span></td>
          )}
          <td class="col-num mono" title={exact(row.volume, "주")}>{formatVolume(row.volume)}</td>
          <td class="col-num mono" title={exact(row.value, "원")}>{formatValue(row.value)}</td>
          <td class="col-num mono" title={exact(row.lastClose, "원")}>{formatPrice(row.lastClose)}</td>
          <td>
            {verdicts.has(row.code) ? (
              <span class={`signal-badge ${verdicts.get(row.code)!.key}`} title={verdicts.get(row.code)!.summary}>
                {verdicts.get(row.code)!.short}
              </span>
            ) : (
              <span class="signal-badge">—</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
